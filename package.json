{
  "name": "ridenote",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:key": "bash scripts/with-keychain.sh next dev",
    "build": "next build",
    "start": "next start",
    "start:key": "bash scripts/with-keychain.sh next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:coverage": "jest --coverage",
    "eval": "jest --config jest.eval.config.mjs",
    "eval:key": "bash scripts/with-keychain.sh jest --config jest.eval.config.mjs",
    "key": "bash scripts/keychain.sh help",
    "key:status": "bash scripts/keychain.sh status",
    "key:set": "bash scripts/keychain.sh set",
    "key:remove": "bash scripts/keychain.sh remove",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-query": "^5.105.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
